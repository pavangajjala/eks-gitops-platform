{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "argocd": {
    "managerFilePatterns": ["/^gitops/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Group platform chart updates into one weekly pull request",
      "matchManagers": ["argocd"],
      "groupName": "platform charts",
      "schedule": ["before 6am on monday"]
    }
  ]
}
